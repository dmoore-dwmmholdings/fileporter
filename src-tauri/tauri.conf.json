{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fileporter",
  "version": "0.1.1",
  "identifier": "io.fileporter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fileporter",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Private local-network file transfer",
    "longDescription": "Fileporter transfers files directly between automatically discovered devices on a private local network.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": { "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" } },
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" }
  }
}
